rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'AROYANSABILALMUSTAKIM@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.category is string && data.category.size() <= 50;
    }

    function isValidTransaction(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() <= 60 &&
             data.finalAmount is number && data.finalAmount >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() <= 30 &&
             data.status is string && data.status.size() <= 20;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() <= 100 &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidAdminDoc(data) {
      return data.email is string && data.email.size() <= 100 &&
             data.role is string && (data.role == 'admin' || data.role == 'kasir');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Products catalog: readable by customers and staff, writable by signed in staff/admins
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(request.resource.data);
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isSignedIn() && isValidId(productId);
    }

    // Transactions log: readable by signed-in staff, created by customers or cashiers
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isValidId(transactionId) && isValidTransaction(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() && isValidId(transactionId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admins collection: managed by Super Admin
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminDoc(request.resource.data);
      allow update: if isAdmin() && isValidId(adminId) && isValidAdminDoc(request.resource.data);
      allow delete: if isAdmin() && isValidId(adminId);
    }
  }
}
